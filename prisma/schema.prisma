generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model model {
  id                    Int        @id @default(autoincrement())
  name                  String
  wife                  Int        @default(0)
  brest                 Int        @default(0)
  ass                   Int        @default(0)
  face                  Int        @default(0)
  height                Int        @default(0)
  averageRating         Int        @default(0)
  overall               Int        @default(0)
  content               Int        @default(0)
  body                  Int        @default(0)
  hair                  Int        @default(0)
  nipples               Int        @default(0)
  legs                  Int        @default(0)
  pussy                 Int        @default(0)
  Final                 Int        @default(0)
  Quarterfinals         Int        @default(0)
  Semifinals            Int        @default(0)
  winner                Int        @default(0)
  winStreak             Int        @default(0)
  duelLose              Int        @default(0)
  duelWin               Int        @default(0)
  duelRating            Int        @default(0)
  isOnline              Boolean    @default(false)
  onlineCount           Int        @default(0)
  videoCount            Int        @default(0)
  avatarLink            String?
  image_url             String?
  instagram             String?
  tiktok                String?
  videoid               String?    @db.VarChar(2048)
  duelTir               DuelTier   @default(D)
  videos                Video[]
  winRate               Float @default(0)
  // Back-relations for duel stats:
  duelStatsAsChallenger DuelStat[] @relation("ChallengerDuels")
  duelStatsAsOpponent   DuelStat[] @relation("OpponentDuels")
}

model DuelStat {
  id           Int  @id @default(autoincrement())
  userId       Int // Changed type to match Model.id (Int)
  opponentId   Int // Changed type to match Model.id (Int)
  totalMatches Int
  wins         Int?

  // Define each relation with a unique name:
  challenger model @relation("ChallengerDuels", fields: [userId], references: [id], onDelete: Cascade)
  opponent   model @relation("OpponentDuels", fields: [opponentId], references: [id],onDelete: Cascade)

  @@unique([userId, opponentId])
}

model Video {
  id      Int    @id @default(autoincrement())
  link    String
  modelId Int
  model   model  @relation(fields: [modelId], references: [id], onDelete: Cascade )
}

enum DuelTier {
  S
  A
  B
  C
  D
  E
  F
  G
  H
}
